# Salin file ini menjadi .env di VPS Hostinger (jangan commit .env ke GitHub)
APP_ENV=production

# Port host VPS (gunakan 8010 agar TIDAK bentrok dengan FastAPI lain di port 8000)
APP_HOST_PORT=8010

# PostgreSQL internal Docker (pgvector/pgvector:pg17)
POSTGRES_DB=face_registration
POSTGRES_USER=face_app_user
POSTGRES_PASSWORD=GANTI_PASSWORD_DB_YANG_KUAT

# Model & Threshold terkalibrasi (V1)
FACE_MODEL_PATH=Face Recognition/artifacts/exported_models/imsfd_partial_ft_v1/inceptionresnetv1_imsfd_partial_finetuned.pth
FACE_MODEL_VERSION=imsfd_partial_ft_v1
FACE_THRESHOLD=0.3650529384613037
FACE_DEDUP_THRESHOLD=0.75
FACE_THRESHOLD_VERSION=threshold_v1
FACE_PREPROCESSING_VERSION=mtcnn160_margin20_fixedstd_v1
FACE_MODEL_TRAIN_PREPROCESSING_VERSION=squarepad_resize160_fixedstd_v1
FACE_DEVICE=cpu
FACE_IMAGE_SIZE=160
MTCNN_MARGIN=20
MTCNN_MIN_FACE_SIZE=20
MTCNN_THRESHOLDS=0.6,0.7,0.7

# Password Panel Admin / Operator (ganti lebih kuat setelah selesai demo)
ADMIN_API_KEY=1234

# Anti-Spoofing / PAD MiniFASNetV2 terkalibrasi
ANTI_SPOOF_PROVIDER=faceid.antispoof.silentface_provider:create_provider
PAD_REPO_ROOT=Face Recognition/third_party/Silent-Face-Anti-Spoofing
PAD_WEIGHTS_DIR=Face Recognition/artifacts/antispoof/weights
PAD_LIVE_THRESHOLD=0.430230
REQUIRE_ANTISPOOF=true

# MLflow (opsional jika server MLflow berjalan)
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Runtime & CORS (ganti dengan subdomain HTTPS kamu)
LOG_LEVEL=INFO
MAX_UPLOAD_MB=8
CORS_ORIGINS=https://ujian.domain-kamu.com
