# Copy to .env. Never commit .env.
APP_ENV=development

# MLflow tracking (blank = use local SQLite during first smoke test)
MLFLOW_BACKEND_STORE_URI=
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# PostgreSQL application database (separate from MLflow database)
DATABASE_URL=postgresql+psycopg://face_app_user:CHANGE_ME@127.0.0.1:5432/face_registration

# Model artifact copied manually from Google Drive export
FACE_MODEL_PATH=Face Recognition/artifacts/exported_models/imsfd_partial_ft_v1/inceptionresnetv1_imsfd_partial_finetuned.pth
FACE_MODEL_VERSION=imsfd_partial_ft_v1
# Set this only after validation calibration for the exact inference preprocessing.
FACE_THRESHOLD=
FACE_THRESHOLD_VERSION=not_calibrated
FACE_PREPROCESSING_VERSION=mtcnn160_margin20_fixedstd_v1
FACE_MODEL_TRAIN_PREPROCESSING_VERSION=squarepad_resize160_fixedstd_v1
FACE_DEVICE=auto
FACE_IMAGE_SIZE=160
MTCNN_MARGIN=20
MTCNN_MIN_FACE_SIZE=20
MTCNN_THRESHOLDS=0.6,0.7,0.7

# Operator/admin key for prototype only; use a strong random secret.
ADMIN_API_KEY=CHANGE_TO_LONG_RANDOM_SECRET

# Anti-spoofing: unconfigured means verification is REVIEW_REQUIRED when required.
# Silent-Face-Anti-Spoofing (PAD) — configure only after model/threshold validation.
ANTI_SPOOF_PROVIDER=
PAD_REPO_ROOT=Face Recognition/third_party/Silent-Face-Anti-Spoofing
PAD_WEIGHTS_DIR=Face Recognition/artifacts/antispoof/weights
PAD_LIVE_THRESHOLD=
REQUIRE_ANTISPOOF=true

# Metrics/logging
LOG_LEVEL=INFO
MAX_UPLOAD_MB=8
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000
